#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./cv INPUT.md [OUTPUT.pdf]
  ./cv --setup

If OUTPUT.pdf is omitted, the script writes INPUT.pdf next to the input file.
Set CV_CHROME when Chrome or Chromium is installed in a non-standard location.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "--setup" ]]; then
  if ! command -v npm >/dev/null 2>&1; then
    printf 'npm is required. Install Node.js and npm first.\n' >&2
    exit 1
  fi
  npm install --prefix "$SCRIPT_DIR" --no-audit --no-fund
  exit 0
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
  usage >&2
  exit 1
fi

input="$1"
if [[ "$input" != /* ]]; then
  input="$PWD/$input"
fi

if [[ ! -f "$input" ]]; then
  printf 'Input file not found: %s\n' "$input" >&2
  exit 1
fi

case "$input" in
  *.md|*.markdown) ;;
  *)
    printf 'Input must be a Markdown file: %s\n' "$input" >&2
    exit 1
    ;;
esac

if [[ $# -eq 2 ]]; then
  output="$2"
else
  case "$input" in
    *.md) output="${input%.md}.pdf" ;;
    *.markdown) output="${input%.markdown}.pdf" ;;
  esac
fi

case "$output" in
  *.pdf|*.PDF) ;;
  *) output="${output}.pdf" ;;
esac

if [[ "$output" != /* ]]; then
  output="$PWD/$output"
fi

output_dir="$(dirname -- "$output")"
mkdir -p -- "$output_dir"

if ! command -v node >/dev/null 2>&1; then
  printf 'Node.js is required. Install Node.js first.\n' >&2
  exit 1
fi

if [[ ! -d "$SCRIPT_DIR/node_modules/marked" ]]; then
  printf 'Dependencies are missing. Run "./cv --setup" first.\n' >&2
  exit 1
fi

browser="${CV_CHROME:-}"
if [[ -n "$browser" && "$browser" != */* ]]; then
  browser="$(command -v "$browser" 2>/dev/null || true)"
fi

if [[ -z "$browser" ]]; then
  for candidate in google-chrome google-chrome-stable chromium chromium-browser; do
    if browser_path="$(command -v "$candidate" 2>/dev/null)"; then
      browser="$browser_path"
      break
    fi
  done
fi

if [[ -z "$browser" || ! -x "$browser" ]]; then
  printf 'Chrome or Chromium is required. Set CV_CHROME to its executable path.\n' >&2
  exit 1
fi

temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/cv-pdf.XXXXXX")"
cleanup() {
  rm -rf -- "$temporary_dir"
}
trap cleanup EXIT

node "$SCRIPT_DIR/render-cv.mjs" "$input" "$temporary_dir/index.html"

browser_args=(
  --headless=new
  --disable-gpu
  --disable-software-rasterizer
  --no-pdf-header-footer
  "--print-to-pdf=$output"
)

if [[ "$(id -u)" -eq 0 ]]; then
  browser_args+=(--no-sandbox)
fi

"$browser" "${browser_args[@]}" "file://$temporary_dir/index.html" >/dev/null 2>&1

if [[ ! -s "$output" ]]; then
  printf 'Chrome did not create a PDF: %s\n' "$output" >&2
  exit 1
fi

printf 'Created %s\n' "$output"
